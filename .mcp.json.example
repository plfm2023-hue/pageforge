{
  "_readme": [
    "Copy this file to .mcp.json and configure:",
    "",
    "DEVELOPMENT (localhost):",
    "  FIGMA_SERVER_URL: http://localhost:3003",
    "  API_KEY: dev-key",
    "",
    "PRODUCTION (your deployed server):",
    "  FIGMA_SERVER_URL: https://pageforge.example.com",
    "  API_KEY: <your-strong-key>",
    "",
    "Get SESSION_ID from the PageForge Figma plugin > MCP Config button"
  ],
  "mcpServers": {
    "pageforge": {
      "command": "node",
      "args": ["./mcp-server.js"],
      "env": {
        "FIGMA_SERVER_URL": "http://localhost:3003",
        "API_KEY": "dev-key",
        "FIGMA_SESSION_ID": "YOUR_SESSION_ID_HERE"
      }
    }
  }
}
