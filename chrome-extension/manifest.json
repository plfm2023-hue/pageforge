{
  "manifest_version": 3,
  "name": "PageForge Capture",
  "version": "0.1.0",
  "description": "Capture the current web page as HTML and send it straight to Figma via PageForge (HTML-to-Figma, with AI/MCP).",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PageForge Capture"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
