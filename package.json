{
  "name": "pageforge",
  "version": "0.1.0",
  "description": "PageForge — turn any web page into an editable Figma design, powered by AI/MCP. Figma plugin + MCP/SSE bridge + Chrome capture extension.",
  "type": "module",
  "main": "mcp-server.js",
  "bin": {
    "pageforge": "./mcp-server.js"
  },
  "scripts": {
    "dev": "npm run build:watch",
    "build": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife && cp src/ui.html ui.html",
    "build:watch": "cp src/ui.html ui.html && esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife --watch",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node sse-server.js",
    "diagnose": "node scripts/test-mcp-status.js",
    "generate-config": "node scripts/generate-mcp-config.js"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.65.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  }
}
